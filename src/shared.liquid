{% assign wednesday_lunch = trmnl.plugin_settings.custom_fields_values.wednesday_lunch | default: '-' %}
{% assign wednesday_dinner = trmnl.plugin_settings.custom_fields_values.wednesday_dinner | default: '-' %}

