    {% assign day_thu = "Giovedì" %}
    {% assign day_fri = "Venerdì" %}
    {% assign day_sat = "Sabato" %}
    {% assign day_sun = "Domenica" %}
    {% assign title_wmp = "Piano pasti settimanale" %}

    {% assign label_breakfast = "Colazione" %}
    {% assign label_lunch = "Pranzo" %}
    {% assign label_dinner = "Cena" %}

    {% assign label_breakfast_short = "Col." %}
    {% assign label_lunch_short = "Pranzo" %}
    {% assign label_dinner_short = "Cena" %}

  {% when "es" %}
