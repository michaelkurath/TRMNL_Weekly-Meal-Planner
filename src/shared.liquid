    {% assign day_tue = "Martes" %}
    {% assign day_wed = "Miércoles" %}
    {% assign day_thu = "Jueves" %}
    {% assign day_fri = "Viernes" %}
    {% assign day_sat = "Sábado" %}
    {% assign day_sun = "Domingo" %}
    {% assign title_wmp = "Planificador semanal" %}

    {% assign label_breakfast = "Desayuno" %}
    {% assign label_lunch = "Almuerzo" %}
    {% assign label_dinner = "Cena" %}

    {% assign label_breakfast_short = "Des." %}
    {% assign label_lunch_short = "Alm." %}
    {% assign label_dinner_short = "Cena" %}

  {% when "nl" %}
    {% assign day_mon = "Maandag" %}
    {% assign day_tue = "Dinsdag" %}
    {% assign day_wed = "Woensdag" %}
    {% assign day_thu = "Donderdag" %}
    {% assign day_fri = "Vrijdag" %}
    {% assign day_sat = "Zaterdag" %}
    {% assign day_sun = "Zondag" %}
    {% assign title_wmp = "Wekelijkse maaltijdplanner" %}

