    {% assign label_lunch = "Lunch" %}
    {% assign label_dinner = "Avondeten" %}

    {% assign label_breakfast_short = "Ontb." %}
    {% assign label_lunch_short = "Lunch" %}
    {% assign label_dinner_short = "Avond" %}

  {% else %}
    {% assign day_mon = "Monday" %}
    {% assign day_tue = "Tuesday" %}
    {% assign day_wed = "Wednesday" %}
    {% assign day_thu = "Thursday" %}
    {% assign day_fri = "Friday" %}
    {% assign day_sat = "Saturday" %}
    {% assign day_sun = "Sunday" %}
