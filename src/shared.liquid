{% assign sunday_lunch = trmnl.plugin_settings.custom_fields_values.sunday_lunch | default: '-' %}
{% assign sunday_dinner = trmnl.plugin_settings.custom_fields_values.sunday_dinner | default: '-' %}

<style>
  .meal-test-layout {
    height: 100%;
    width: 100%;
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    align-items: stretch !important;
    overflow: hidden;
  }

  .meal-card-grid {
    width: 100%;
    display: grid;
    box-sizing: border-box;
    flex: 0 0 auto;
  }

  .meal-card {
    border: 1px solid #000;
    border-radius: 6px;
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
  }

  .meal-card.today {
    background: #000;
    color: #fff;
  }

  .meal-day {
    font-weight: 700;
    border-bottom: 1px solid currentColor;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meal-line {
    display: flex;
    align-items: baseline;
    min-width: 0;
    line-height: 1.05;
  }

  .meal-label {
    flex: 0 0 auto;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meal-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meal-full .meal-card-grid {
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .meal-full .meal-card {
    padding: 5px 7px;
  }

  .meal-full .meal-day {
    font-size: 20px;
    padding-bottom: 3px;
    margin-bottom: 4px;
  }

  .meal-full .meal-line {
    font-size: 14px;
    gap: 6px;
  }

  .meal-full .meal-label {
    min-width: 78px;
  }

  .meal-full .meal-value {
    flex: 1 1 auto;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    white-space: normal;
    overflow-wrap: anywhere;
    text-overflow: clip;
  }

  .meal-half-horizontal .meal-card-grid {
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .meal-half-horizontal .meal-card {
    padding: 2px 4px;
    border-radius: 4px;
  }

  .meal-half-horizontal .meal-day {
    font-size: 10px;
    padding-bottom: 1px;
    margin-bottom: 1px;
  }

  .meal-half-horizontal .meal-line {
    font-size: 8px;
    line-height: 1;
    gap: 2px;
  }

  .meal-half-horizontal .meal-label {
    min-width: 58px;
  }

  .meal-half-vertical .meal-card-grid {
    grid-template-columns: 1fr;
    gap: 3px;
  }

  .meal-half-vertical .meal-card {
    padding: 3px 5px;
  }

  .meal-half-vertical .meal-day {
    font-size: 13px;
    padding-bottom: 2px;
    margin-bottom: 2px;
  }

  .meal-half-vertical .meal-line {
    font-size: 10px;
    gap: 4px;
    line-height: 1.02;
  }

  .meal-half-vertical .meal-label {
    min-width: 38px;
  }

  .meal-quadrant .meal-card-grid {
    grid-template-columns: 1fr 1fr;
    gap: 3px;
  }

  .meal-quadrant .meal-card {
    padding: 2px 4px;
    border-radius: 4px;
  }

  .meal-quadrant .meal-day {
    font-size: 10px;
    padding-bottom: 1px;
    margin-bottom: 1px;
  }

  .meal-quadrant .meal-line {
    font-size: 8px;
    line-height: 1;
    gap: 2px;
  }

  .meal-quadrant .meal-label {
    min-width: 34px;
  }

 /* TRMNL X / larger screens */
@media screen and (min-width: 1000px) {
  .meal-full .meal-card-grid {
    gap: 14px;
  }

  .meal-full .meal-card {
    padding: 12px 14px;
    border-radius: 10px;
  }

  .meal-full .meal-day {
    font-size: 34px;
    padding-bottom: 5px;
    margin-bottom: 8px;
  }

  .meal-full .meal-line {
    font-size: 22px;
    line-height: 1.15;
    gap: 10px;
  }

  .meal-full .meal-label {
    min-width: 120px;
  }

  .meal-full .meal-value {
    -webkit-line-clamp: 3;
  }

  /*
    Half horizontal on X:
    Still compact, but no need to be as tiny as OG.
  */
  .meal-half-horizontal .meal-card-grid {
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }

  .meal-half-horizontal .meal-card {
    padding: 5px 7px;
    border-radius: 6px;
  }

  .meal-half-horizontal .meal-day {
    font-size: 16px;
    padding-bottom: 2px;
    margin-bottom: 2px;
  }

  .meal-half-horizontal .meal-line {
    font-size: 12px;
    line-height: 1.05;
    gap: 4px;
  }

  .meal-half-horizontal .meal-label {
    min-width: 88px;
  }

  /*
    Half vertical on X:
    Much more readable than OG, but still single column.
  */
  .meal-half-vertical .meal-card-grid {
    gap: 7px;
  }

  .meal-half-vertical .meal-card {
    padding: 7px 9px;
    border-radius: 8px;
  }

  .meal-half-vertical .meal-day {
    font-size: 21px;
    padding-bottom: 3px;
    margin-bottom: 4px;
  }

  .meal-half-vertical .meal-line {
    font-size: 15px;
    line-height: 1.08;
    gap: 5px;
  }

  .meal-half-vertical .meal-label {
    min-width: 58px;
  }

  /*
    Quadrant on X:
    Can be bigger than OG but still must fit all 7 days.
  */
  .meal-quadrant .meal-card-grid {
    grid-template-columns: 1fr 1fr;
    gap: 5px;
  }

  .meal-quadrant .meal-card {
    padding: 4px 6px;
    border-radius: 6px;
  }

  .meal-quadrant .meal-day {
    font-size: 14px;
    padding-bottom: 2px;
    margin-bottom: 2px;
  }

  .meal-quadrant .meal-line {
    font-size: 10px;
    line-height: 1.05;
    gap: 3px;
  }

  .meal-quadrant .meal-label {
    min-width: 44px;
  }
}
</style>